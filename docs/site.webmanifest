{
  "name": "grove",
  "short_name": "grove",
  "description": "status, diffs and logs across every git repository under one directory",
  "start_url": "/",
  "display": "browser",
  "background_color": "#F6F3EA",
  "theme_color": "#F6F3EA",
  "icons": [
    { "src": "assets/grove-icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "assets/grove-icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "assets/grove-icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ]
}
